# Supabase credentials for the ManzilQ project.
# Copy this file to .env and fill in the real values.
# The anon key is a PUBLIC client key (it ships in the browser bundle).
# NEVER put the service_role key here — it stays in the Supabase dashboard only.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
